*.py[cod]
*.egg-info/
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments and secrets
.venv/
venv/
env/
.env
.env.*
!.env.example
kaggle.json
*.pem

# IDE and operating system
.idea/
.vscode/
.DS_Store
Thumbs.db

# Raw/intermediate data: commit only documentation, placeholders, and manifests
data/*
!data/README.md
!data/raw/
data/raw/*
!data/raw/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep
!data/splits/
!data/splits/**
!data/manifests/
!data/manifests/**

# Model artifacts and experiment trackers
*.pt
*.pth
*.ckpt
*.onnx
*.engine
/checkpoints/
/results/checkpoints/*
!/results/checkpoints/.gitkeep
runs/
wandb/
mlruns/
artifacts/

# Generated reports and profiling output
reports/figures/generated/
reports/tables/generated/
profiling/

# Local tools and temporary files
.tools/
tmp/
temp/
*.tmp
*.log

# Local agent tools, instructions, session memory, and work queues
/.codex/
/AGENTS.md
/CODEX.md
/HANDOFF.md
/PROJECT_SPEC.md
/BATCHES*.md
/CHAT_RESPONSE_AUDIT&PRIORITY.md
/docs/POSTHOC_EXTERNAL_GENERALIZATION_CHECKPOINT.md

# Keep the published knowledge graph, but not its cache or machine state
/graphify-out/cache/
/graphify-out/.graphify_*

# Local setup failures and orchestration; accepted scientific runs stay tracked
/results/logs/*_aborted-*/
/results/logs/*_aborted_*/
/results/logs/*_failed-*/
/results/logs/*_rejected-*/
/results/logs/*_smoke_*/
/results/logs/phase5_orchestration/
/results/logs/phase16_orchestration/

